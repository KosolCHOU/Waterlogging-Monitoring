# Enhanced Z-Test Configuration for Waterlogging Risk Assessment
# This file documents the enhanced statistical robustness parameters

## Core Z-Test Parameters
S1_ROLL_WINDOW_DAYS=60          # Base rolling window size in days
S1_Z_THRESHOLD=-1.5             # Z-score threshold for alerts
S1_MIN_Z_SAMPLES=6              # Minimum historical samples required
S1_MAD_EPS=1e-6                 # Floor value for MAD to prevent division issues
S1_WATCH_Z=-0.8                 # Z-score threshold for watch status

## Enhanced Robustness Features
# Seasonal Decomposition - handles agricultural cycles
S1_ENABLE_SEASONAL=True         # Enable seasonal pattern removal
S1_SEASONAL_PERIOD=365          # Expected seasonal cycle length (days)
S1_MIN_SEASONAL_SAMPLES=24      # Minimum samples needed for decomposition

# Adaptive Window Sizing - adjusts to data availability
S1_ADAPTIVE_WINDOW=True         # Enable adaptive window sizing
S1_MIN_WINDOW_DAYS=30           # Minimum adaptive window size
S1_MAX_WINDOW_DAYS=120          # Maximum adaptive window size

# Stationarity Testing - ensures statistical validity
S1_STATIONARITY_TEST=True       # Enable ADF stationarity testing
S1_ADF_PVALUE=0.05              # P-value threshold for stationarity

# Regime Change Detection - handles shifting baselines
S1_REGIME_DETECTION=True        # Enable regime change detection
S1_REGIME_WINDOW_RATIO=0.3      # Fraction of data for regime comparison

## Usage Examples:
# Conservative (more false negatives, fewer false positives):
# S1_Z_THRESHOLD=-2.0
# S1_MIN_Z_SAMPLES=10
# S1_REGIME_DETECTION=False

# Aggressive (more false positives, fewer false negatives):
# S1_Z_THRESHOLD=-1.0
# S1_MIN_Z_SAMPLES=4
# S1_ADAPTIVE_WINDOW=True

# Seasonal crops (rice, wheat):
# S1_ENABLE_SEASONAL=True
# S1_SEASONAL_PERIOD=365

# High-frequency monitoring:
# S1_MIN_WINDOW_DAYS=15
# S1_ADAPTIVE_WINDOW=True